# Orbital Sentinel backend environment.
# Copy to backend/.env (loaded relative to main.py; repo-root .env is a fallback).
# ENABLE_EXTENDED_PIPELINE=1 turns on the LSTM recorder, Foster-trained XGBoost,
# anomaly detection and shadow-mode retraining. Code default is 0.
ENABLE_EXTENDED_PIPELINE=1
SHADOW_MODE_ENABLED=1
SHADOW_HORIZON_MINUTES=5
SNAPSHOT_REFRESH_SECONDS=1
ALERT_REFRESH_SECONDS=30
ALLOW_UNAUTHENTICATED_COMMANDS=1
KAFKA_ENABLED=0
